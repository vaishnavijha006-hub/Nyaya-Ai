# Nyaya AI Environment Configuration Template
# Copy this file to .env.local for local Next.js development

# ── Next.js Client & Backend URLs ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── Supabase Configuration (Auth, Database, Storage) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Vector Search / Qdrant Integration ──
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── AI Model Provider Keys ──
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# ── System Operational Mode ──
NODE_ENV=development
