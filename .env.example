# Nyaya AI Environment Variables Reference

# ── Frontend Configuration ──────────────────────────────────────────────────
# Required: API endpoint URL for backend FastAPI communication
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: Supabase client URL and public anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Backend Configuration ───────────────────────────────────────────────────
# Required for production AI inference (Groq / Gemini)
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Optional: Server environment mode
ENVIRONMENT=production
LOG_LEVEL=INFO
